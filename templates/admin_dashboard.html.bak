<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>پنل مدیریت</title>
    <link rel="stylesheet" href="/static/style.css">
<link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet">
    <style>body,input,textarea,button,select{font-family:"Vazirmatn","Segoe UI",Tahoma,sans-serif !important;}</style>
<script src="/static/custom-alert.js"></script>
<link rel="manifest" href="/static/manifest.json">
<meta name="theme-color" content="#00ff9d">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="پنل پیامکی">
<link rel="apple-touch-icon" href="/static/icon-192.png">
<script>
if ('serviceWorker' in navigator) {
    window.addEventListener('load', function() {
        navigator.serviceWorker.register('/static/service-worker.js').catch(function(){});
    });
}
</script>
</head>
<body class="matrix-bg">
<div class="container">
    <div class="header-bar"><div class="header-title">👑 پنل مدیریت کل</div></div>

    {% with messages = get_flashed_messages(with_categories=true) %}
        {% for cat, msg in messages %}
            <div class="{{ 'success' if cat=='success' else 'error' }}">{{ msg }}</div>
        {% endfor %}
    {% endwith %}

    <div class="stats">
        <div class="stat-box"><span class="stat-label">کل پیامک‌ها</span><span class="stat-value">{{ total_sms }}</span></div>
        <div class="stat-box"><span class="stat-label">کاربران</span><span class="stat-value">{{ users|length }}</span></div>
        <div class="stat-box"><span class="stat-label">آنلاین</span><span class="stat-value">{{ stats.online }}</span></div>
    </div>

    <div class="footer-box">
        <div class="footer-title">⚙ گزینه‌ها</div>
        <div class="footer-actions">
            <button type="button" class="btn-nav" onclick="openAddModal()">➕ افزودن مغازه</button>
            <a href="/admin/stats" class="btn-nav" style="background:#330000;color:#ffbe0b;border-color:#ffbe0b;">📊 آمار</a>
<a href="/admin/contacts" class="btn-nav" style="background:#330033;color:#ff00ff;border-color:#ff00ff;">📞 مخاطبین</a>
<a href="/admin/templates" class="btn-nav" style="background:#332200;color:#ffbe0b;border-color:#ffbe0b;">✉ قالب‌ها</a>
<a href="/admin/backups" class="btn-nav" style="background:#1a0033;color:#bf00ff;border-color:#bf00ff;">💾 بکاپ</a>
<a href="/admin/wallets" class="btn-nav" style="background:#003322;color:#00ff9d;border-color:#00ff9d;">💰 کیف پول‌ها</a>
<a href="/admin/tickets" class="btn-nav" style="background:#33001a;color:#ff2e63;border-color:#ff2e63;">🎫 تیکت‌ها</a>
            <a href="/admin/loyalty" class="btn-nav" style="background:#332200;color:#ffd700;border-color:#ffd700;">🎁 باشگاه مشتریان</a>
            <a href="/admin/referrals" class="btn-nav" style="background:#1a0033;color:#bf00ff;border-color:#bf00ff;">🎯 رتبه‌بندی دعوت</a>
            <a href="/admin/reports" class="btn-nav" style="background:#001a33;color:#00d4ff;border-color:#00d4ff;">📈 گزارش درآمد</a>
            <a href="/admin/ai-manager" class="btn-nav" style="background:#1a0033;color:#bf00ff;border-color:#bf00ff;">🤖 مدیر AI</a>
            <a href="/admin/bot-ads" class="btn-nav" style="background:#330033;color:#ff00ff;border-color:#ff00ff;">📢 تبلیغات ربات</a>
<a href="/admin/bots" class="btn-nav" style="background:#1a0033;color:#bf00ff;border-color:#bf00ff;">🤖 ربات‌های ادمین</a>
<a href="/admin/public-url" class="btn-nav" style="background:#003322;color:#00ff9d;border-color:#00ff9d;">🌐 آدرس عمومی</a>
<a href="/admin/bot-members" class="btn-nav" style="background:#001a33;color:#00d4ff;border-color:#00d4ff;">👥 کاربران ربات</a>
            <a href="/admin/test-sms" class="btn-nav" style="background:#003322;color:#00ff9d;border-color:#00ff9d;">📨 تست پیامک</a>
            <a href="/admin/birthdays" class="btn-nav" style="background:#33001a;color:#ff64a0;border-color:#ff64a0;">🎂 تولدها</a>
            <a href="/admin/logs" class="btn-nav" style="background:#001a33;color:#00d4ff;border-color:#00d4ff;">📋 لاگ ورودها</a>
            <button type="button" class="btn-nav btn-logout" onclick="openExitModal()">❌ خروج</button>
        </div>
    </div>

    <h2>🏪 لیست مغازه‌ها</h2>
    <div class="table-wrap">
        <table>
            <tr>
                <th>ID</th>
                <th>کاربر</th>
                <th>مغازه</th>
                <th>روز</th>
                <th>پیامک</th>
                <th>مصرف</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
            {% for u in users %}
            <tr>
                <td>{{ u.id }}</td>
                <td>{{ u.username }}</td>
                <td>{{ u.shop_name or '-' }}</td>
                <td>{{ u.days_left }}</td>
                <td>{{ u.sms_left }}/{{ u.sms_limit }}</td>
                <td>{{ u.sms_used }}</td>
                <td>{{ '✅' if u.status=='active' else '⛔' }}</td>
                <td><a href="/admin/user/{{ u.id }}" class="btn-mini">👁</a></td>
            </tr>
            {% endfor %}
        </table>
    </div>
</div>

<div id="addModal" class="modal-overlay">
    <div class="modal-box" style="border-color:#00ff41;">
        <div class="modal-icon" style="color:#00ff41;text-shadow:0 0 20px #00ff41;">➕</div>
        <div class="modal-title" style="color:#00ff41;">افزودن مغازه جدید</div>
        <form method="post" action="/admin/users/add" style="text-align:right;">
            <label class="form-label">نام کاربری</label>
            <input type="text" name="username" required>
            <label class="form-label">رمز عبور</label>
            <input type="text" name="password" required>
            <label class="form-label">نام مغازه</label>
            <input type="text" name="shop_name">
            <label class="form-label">شماره تماس</label>
            <input type="text" name="phone">
            <label class="form-label">مدت اشتراک (روز)</label>
            <input type="number" name="days" value="30" min="1">
            <label class="form-label">محدودیت پیامک (تعداد کل)</label>
            <input type="number" name="sms_limit" value="1000" min="1">
            <div class="modal-actions" style="margin-top:15px;">
                <button type="button" class="modal-btn modal-cancel" onclick="closeAddModal()">انصراف</button>
                <button type="submit" class="modal-btn" style="background:#00ff41;color:#000;border-color:#00ff41;">ساخت</button>
            </div>
        </form>
    </div>
</div>

<div id="exitModal" class="modal-overlay">
    <div class="modal-box" style="border-color:#ff0040;">
        <div class="modal-icon" style="color:#ff0040;">❌</div>
        <div class="modal-title" style="color:#ff0040;">خروج از پنل</div>
        <div class="modal-text">آیا مطمئنی می‌خوای از پنل خارج بشی؟</div>
        <div class="modal-actions">
            <button type="button" class="modal-btn modal-cancel" onclick="closeExitModal()">انصراف</button>
            <a href="/admin/logout" class="modal-btn modal-confirm" style="text-decoration:none;display:flex;align-items:center;justify-content:center;">بله، خارج شو</a>
        </div>
    </div>
</div>



<script>
    function openAddModal(){document.getElementById('addModal').classList.add('show');}
    function closeAddModal(){document.getElementById('addModal').classList.remove('show');}
    function openExitModal(){document.getElementById('exitModal').classList.add('show');}
    function closeExitModal(){document.getElementById('exitModal').classList.remove('show');}
    document.getElementById('exitModal').addEventListener('click', function(e){if(e.target===this)closeExitModal();});
    document.getElementById('addModal').addEventListener('click', function(e){if(e.target===this)closeAddModal();});
</script>
<nav class="bottom-nav">
    <a href="/admin/dashboard" class="nav-item active">
        <span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M3 10.5L12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9 21v-6h6v6"/></svg></span>
        <span class="nav-label">پنل</span>
    </a>
    <a href="/admin/chat" class="nav-item">
        <span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-8 8H7l-4 3v-8a8 8 0 0 1 8-8h2a8 8 0 0 1 8 5z"/><circle cx="9" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="12" r="1" fill="currentColor" stroke="none"/></svg></span>
        <span class="nav-label">چت</span>
        {% if unread_chat and unread_chat > 0 %}<span class="nav-badge">{{ unread_chat }}</span>{% endif %}
    </a>
    <a href="/admin/ai" class="nav-item">
        <span class="nav-icon"><svg viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="12" rx="3"/><circle cx="9" cy="14" r="1.5" fill="currentColor" stroke="none"/><circle cx="15" cy="14" r="1.5" fill="currentColor" stroke="none"/><path d="M12 3v5"/><circle cx="12" cy="3" r="1"/></svg></span>
        <span class="nav-label">هوش مصنوعی</span>
    </a>
    <a href="/admin/profile" class="nav-item">
        <span class="nav-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg></span>
        <span class="nav-label">پروفایل</span>
    </a>
</nav>

{% include "_global_bg.html" %}

<!-- زنگوله اعلان‌ها -->
<a href="#" id="notifBellLink" class="notif-bell" title="اعلان‌ها">
🔔
<span class="notif-badge-bell" id="notifBadge" style="display:none;">0</span>
</a>
<script>
(function() {
    if (window.__notif_loaded) return;
    window.__notif_loaded = true;
    function updateNotifCount() {
        fetch('/api/notif/count').then(function(r) { return r.json(); }).then(function(data) {
            var badge = document.getElementById('notifBadge');
            if (!badge) return;
            if (data.count > 0) {
                badge.textContent = data.count > 99 ? '99+' : data.count;
                badge.style.display = 'block';
            } else {
                badge.style.display = 'none';
            }
        }).catch(function() {});
    }
    updateNotifCount();
    setInterval(updateNotifCount, 30000);
})();
</script>


<script>
(function() {
    var bell = document.getElementById('notifBellLink');
    if (bell) {
        if (window.location.pathname.indexOf('/admin/') === 0) {
            bell.href = '/admin/notifications';
        } else {
            bell.href = '/notifications';
        }
    }
})();
</script>

</body>
</html>
