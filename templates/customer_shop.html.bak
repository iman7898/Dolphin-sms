<!DOCTYPE html><html lang="fa" dir="rtl"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ shop[2] or shop[1] }}</title>
<link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet">
<style>
*{box-sizing:border-box}
body{font-family:Vazirmatn,Tahoma,sans-serif;color:#e2e8f0;min-height:100vh;padding:74px 14px 130px;margin:0;background:#020a08;background-image:radial-gradient(circle at 15% 0%,rgba(0,212,255,.14),transparent 45%),radial-gradient(circle at 85% 100%,rgba(0,212,255,.14),transparent 45%)}
.back-btn{position:fixed;top:18px;right:18px;background:rgba(0,212,255,.1);color:#00d4ff;border:1px solid #00d4ff;border-radius:10px;padding:7px 14px;font-size:12px;text-decoration:none;z-index:20}
.frame{border:2px solid #00d4ff;border-radius:26px;padding:18px 14px;background:rgba(0,20,15,.35)}
.pt{text-align:center;font-size:20px;font-weight:900;color:#00d4ff;margin:0 0 16px;text-shadow:0 0 14px rgba(0,212,255,.8)}
.box{background:rgba(0,20,15,.7);border:1.5px solid rgba(0,212,255,.35);border-radius:16px;padding:14px;margin-bottom:14px}
.box-t{font-size:14px;color:#00d4ff;margin-bottom:10px;font-weight:bold;text-align:center;padding-bottom:8px;border-bottom:1px solid rgba(0,212,255,.2)}
.row{font-size:13px;color:#cbd5e1;padding:6px 0;display:flex;gap:8px}
.row b{color:#7dfcc7;min-width:90px}
.act{display:flex;gap:8px;margin-bottom:14px}
.btn{flex:1;text-align:center;padding:14px;border-radius:14px;text-decoration:none;font-size:14px;font-weight:900;border:none;cursor:pointer;font-family:inherit}
.btn-order{background:linear-gradient(135deg,#bf00ff,#7700cc);color:#fff;box-shadow:0 0 20px rgba(191,0,255,.7)}
.btn-fav{background:rgba(255,215,0,.15);color:#ffd700;border:1px solid #ffd700}
.btn-fav.on{background:rgba(255,215,0,.35)}
.prod{padding:12px;border-radius:12px;background:rgba(0,10,8,.6);border:1px solid rgba(0,212,255,.25);margin-bottom:8px;display:flex;justify-content:space-between;align-items:center}
.prod-n{font-size:14px;color:#00d4ff;font-weight:bold}
.prod-d{font-size:11px;color:#7dfcc7;margin-top:3px}
.prod-p{font-size:15px;font-weight:900;color:#ffd700;direction:ltr}
.empty{color:#6b8f80;text-align:center;padding:20px;font-size:12.5px}
.nw{position:fixed;bottom:14px;left:14px;right:14px;height:76px;padding:2px;border-radius:40px;background:linear-gradient(90deg,#00d4ff,#00d4ff 35%,#bf00ff 70%,#00d4ff);z-index:100}
.bn2{height:100%;border-radius:38px;background:linear-gradient(180deg,#0a1f1a,#04120e);display:flex;align-items:center;justify-content:space-around;padding:0 6px}
.ni{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;color:#9aa8b2;text-decoration:none;font-size:10.5px;padding:8px 4px}
.ni .ic{font-size:22px;filter:grayscale(1) brightness(.85)}
.ni.act{background:linear-gradient(135deg,rgba(0,212,255,.15),rgba(0,200,140,.06));border-radius:20px}
.ni.act .ic{filter:none;color:#00d4ff}.ni.act span:last-child{color:#00d4ff;font-weight:bold}

/* ===== THEME + ANIMATIONS ===== */
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{background:#0a0a0f !important;color:#e2e8f0 !important;
  font-family:Vazirmatn,Tahoma,sans-serif !important;
  min-height:100vh;overflow-x:hidden;}
@keyframes neonIn{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}
@keyframes neonGlow{
  0%,100%{box-shadow:0 0 15px rgba(0,212,255,.5)}
  50%{box-shadow:0 0 30px rgba(0,212,255,.9)}
}
@keyframes blueGlow{
  0%,100%{box-shadow:0 0 15px rgba(0,212,255,.5)}
  50%{box-shadow:0 0 30px rgba(0,212,255,.9)}
}
@keyframes goldGlow{
  0%,100%{box-shadow:0 0 15px rgba(255,215,0,.5)}
  50%{box-shadow:0 0 30px rgba(255,215,0,.9)}
}
@keyframes softFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
@keyframes shine{
  0%{background-position:-200% 0}
  100%{background-position:200% 0}
}

.back-btn{display:inline-block;margin:14px;padding:10px 18px;
  background:rgba(0,212,255,.08);color:#00d4ff !important;
  border:1.5px solid #00d4ff;border-radius:12px;
  text-decoration:none;font-weight:900;font-size:13px;
  animation:neonGlow 3s ease-in-out infinite;
  transition:.3s;}
.back-btn:hover{transform:translateX(4px);background:rgba(0,212,255,.2)}

.frame{margin:14px;background:linear-gradient(135deg,#0a1520,#0a0a0f);
  border:2px solid #00d4ff;border-radius:24px;padding:20px;
  box-shadow:0 0 30px rgba(0,212,255,.4),inset 0 0 20px rgba(0,212,255,.05);
  animation:neonIn .6s ease-out both,neonGlow 4s ease-in-out 1s infinite;
  position:relative;overflow:hidden;}

.pt{font-size:20px;font-weight:900;color:#00d4ff !important;
  text-align:center;margin-bottom:20px;
  text-shadow:0 0 20px #00d4ff,0 0 40px #00d4ff;
  animation:softFloat 3s ease-in-out infinite;}

.box{margin:16px 0;padding:16px;background:rgba(0,212,255,.04);
  border:1.5px solid rgba(0,212,255,.4);border-radius:18px;
  animation:neonIn .6s ease-out both;
  box-shadow:inset 0 0 20px rgba(0,212,255,.05);}
.box:nth-child(2){animation-delay:.1s}
.box:nth-child(3){animation-delay:.2s}

.box-t{font-size:15px;font-weight:900;color:#00d4ff !important;
  margin-bottom:12px;padding-bottom:10px;
  border-bottom:1.5px dashed rgba(0,212,255,.4);
  text-shadow:0 0 12px #00d4ff;}

.row{display:flex;justify-content:space-between;align-items:center;
  padding:10px 12px;margin:6px 0;border-radius:12px;
  background:rgba(0,212,255,.05);
  border:1px solid rgba(0,212,255,.15);
  font-size:13.5px;color:#e2e8f0;
  transition:.3s;animation:neonIn .5s ease-out both;}
.row:nth-child(1){animation-delay:.05s}
.row:nth-child(2){animation-delay:.1s}
.row:nth-child(3){animation-delay:.15s}
.row:nth-child(4){animation-delay:.2s}
.row:nth-child(5){animation-delay:.25s}
.row:nth-child(6){animation-delay:.3s}
.row:nth-child(7){animation-delay:.35s}
.row:hover{background:rgba(0,212,255,.12);transform:translateX(-4px);
  box-shadow:0 0 20px rgba(0,212,255,.3)}
.row b{color:#00d4ff;font-weight:900;
  text-shadow:0 0 10px rgba(0,212,255,.6);}

.act{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap}

.btn{flex:1;min-width:120px;padding:14px 18px;
  font-family:inherit;font-size:14px;font-weight:900;
  border-radius:16px;border:none;cursor:pointer;
  text-decoration:none;display:flex;align-items:center;justify-content:center;
  gap:6px;transition:.3s cubic-bezier(.2,.8,.2,1);
  position:relative;overflow:hidden;
  animation:neonIn .6s ease-out both;}
.btn::before{content:"";position:absolute;inset:0;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.3),transparent);
  background-size:200% 100%;
  animation:shine 3s linear infinite;}
.btn-order{background:linear-gradient(135deg,#bf00ff,#8b00cc) !important;
  color:#fff !important;
  box-shadow:0 0 25px rgba(191,0,255,.8),inset 0 0 20px rgba(255,255,255,.15);
  animation:neonIn .6s ease-out both,blueGlow 3s ease-in-out 1s infinite;}
.btn-order:hover{transform:translateY(-4px) scale(1.04);
  box-shadow:0 0 45px rgba(191,0,255,1);}
.btn-fav{background:linear-gradient(135deg,#ffd700,#ff8c00) !important;
  color:#1a1a00 !important;
  box-shadow:0 0 25px rgba(255,215,0,.8);
  animation:neonIn .6s ease-out .1s both,goldGlow 3s ease-in-out 1.1s infinite;}
.btn-fav:hover{transform:translateY(-4px) scale(1.04);
  box-shadow:0 0 45px rgba(255,215,0,1);}
.btn-fav.on{background:linear-gradient(135deg,#00d4ff,#0088cc) !important;
  color:#fff !important;
  box-shadow:0 0 25px rgba(0,212,255,.8) !important;}

.prod{display:flex;justify-content:space-between;align-items:center;
  padding:14px 16px;margin:8px 0;border-radius:14px;
  background:linear-gradient(135deg,rgba(255,215,0,.06),rgba(255,140,0,.02));
  border:1.5px solid rgba(255,215,0,.3);
  animation:neonIn .5s ease-out both;
  transition:.3s;}
.prod:hover{transform:translateX(-4px);
  border-color:#ffd700;
  box-shadow:0 0 25px rgba(255,215,0,.5);}
.prod-n{font-size:14px;font-weight:900;color:#ffd700 !important;
  text-shadow:0 0 12px rgba(255,215,0,.6);}
</style></head><body>

<a class="back-btn" href="/customer/search">→ بازگشت</a>

<div class="frame">
<div class="pt">🏪 {{ shop[2] or shop[1] }}</div>

{% if info %}
<div class="box">
<div class="box-t">📋 اطلاعات مغازه</div>
{% if info[0] %}<div class="row"><b>نام:</b>{{ info[0] }}</div>{% endif %}
{% if info[1] %}<div class="row"><b>نوع:</b>{{ info[1] }}</div>{% endif %}
{% if info[2] %}<div class="row"><b>آدرس:</b>{{ info[2] }}</div>{% endif %}
{% if info[3] %}<div class="row"><b>تلفن:</b>{{ info[3] }}</div>{% endif %}
{% if info[4] %}<div class="row"><b>ساعات:</b>{{ info[4] }}</div>{% endif %}
{% if info[5] %}<div class="row"><b>اینستا:</b>{{ info[5] }}</div>{% endif %}
{% if info[6] %}<div class="row"><b>توضیح:</b>{{ info[6] }}</div>{% endif %}
</div>
{% endif %}

<div class="act">
{% if is_fav %}
<form method="POST" action="/customer/fav/{{ shop[0] }}" style="flex:1;margin:0">
<input type="hidden" name="action" value="remove">
<button class="btn btn-fav on" type="submit">⭐ ذخیره‌شده</button>
</form>
{% else %}
<form method="POST" action="/customer/fav/{{ shop[0] }}" style="flex:1;margin:0">
<input type="hidden" name="action" value="add">
<button class="btn btn-fav" type="submit">☆ ذخیره</button>
</form>
{% endif %}
<a href="/customer/order/{{ shop[0] }}" class="btn btn-order">📝 سفارش</a>
</div>

{% if products %}
<div class="box">
<div class="box-t">📦 محصولات</div>
{% for p in products %}
<div class="prod">
<div>
<div class="prod-n">{{ p[1] }}</div>
{% if p[4] %}<div class="prod-d">{{ p[4] }}</div>{% endif %}
</div>
<div class="prod-p">{{ "{:,}".format(p[2]) }} <small style="font-size:10px">ت</small></div>
</div>
{% endfor %}
</div>
{% endif %}

</div>

<div class="nw"><div class="bn2">
<a class="ni" href="/customer/dashboard"><span class="ic">🏠</span><span>خانه</span></a>
<a class="ni" href="/customer/search"><span class="ic">🔍</span><span>جستجو</span></a>
<a class="ni" href="/customer/orders"><span class="ic">📋</span><span>سفارش‌ها</span></a>
<a class="ni" href="/customer/profile"><span class="ic">👤</span><span>پروفایل</span></a>
</div></div>
{% include "_global_bg.html" %}
</body></html>
