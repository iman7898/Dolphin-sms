<!DOCTYPE html><html lang="fa" dir="rtl"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>جستجو</title>
<link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet">
<style>
*{box-sizing:border-box}
body{font-family:Vazirmatn,Tahoma,sans-serif;color:#e2e8f0;min-height:100vh;padding:74px 14px 130px;margin:0;background:#020a08;background-image:radial-gradient(circle at 15% 0%,rgba(0,255,157,.14),transparent 45%),radial-gradient(circle at 85% 100%,rgba(0,212,255,.14),transparent 45%)}
.back-btn{position:fixed;top:18px;right:18px;background:rgba(0,255,157,.1);color:#00ff9d;border:1px solid #00ff9d;border-radius:10px;padding:7px 14px;font-size:12px;text-decoration:none;z-index:20}
.frame{border:2px solid #00ff9d;border-radius:26px;padding:18px 14px;background:rgba(0,20,15,.35)}
.pt{text-align:center;font-size:20px;font-weight:900;color:#00ff9d;margin:0 0 16px;text-shadow:0 0 14px rgba(0,255,157,.8)}
.srch{display:flex;gap:8px;margin-bottom:16px}
.srch input{flex:1;background:rgba(0,10,8,.9);color:#e2e8f0;border:1.5px solid rgba(0,255,157,.35);border-radius:12px;padding:13px;font-family:inherit;font-size:14px}
.srch input:focus{outline:none;border-color:#00ff9d;box-shadow:0 0 15px rgba(0,255,157,.5)}
.srch button{background:linear-gradient(135deg,#00ff9d,#00b377);color:#001a12;border:none;border-radius:12px;padding:13px 20px;font-family:inherit;font-size:14px;font-weight:900;cursor:pointer}
.hint{font-size:11px;color:#7dfcc7;text-align:center;margin-bottom:12px;opacity:.8}
.sec-title{font-size:14px;font-weight:900;color:#ffd700;margin:16px 0 10px;padding-bottom:8px;border-bottom:1px solid rgba(255,215,0,.3);display:flex;justify-content:space-between}
.sec-count{font-size:11px;color:#7dfcc7;font-weight:normal}
.shop{padding:14px;border-radius:14px;background:rgba(0,10,8,.6);border:1.5px solid rgba(0,255,157,.3);margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;gap:10px}
.shop:hover{border-color:rgba(0,255,157,.7);box-shadow:0 0 15px rgba(0,255,157,.3)}
.shop-h{font-size:15px;font-weight:900;color:#00ff9d}
.shop-m{font-size:11px;color:#7dfcc7;margin-top:3px}
.hl{background:rgba(255,215,0,.25);color:#ffd700;padding:1px 4px;border-radius:4px;font-weight:900}
.act-btns{display:flex;gap:6px}
.btn-view{background:rgba(0,212,255,.15);color:#00d4ff;border:1px solid #00d4ff;border-radius:10px;padding:8px 12px;text-decoration:none;font-size:12px;font-weight:900;text-align:center}
.btn-fav{background:rgba(255,215,0,.15);color:#ffd700;border:1px solid #ffd700;border-radius:10px;padding:8px 12px;font-family:inherit;font-size:12px;font-weight:900;cursor:pointer}
.btn-fav.on{background:rgba(255,215,0,.35)}
.prod{padding:12px;border-radius:12px;background:rgba(0,10,8,.6);border:1px solid rgba(255,215,0,.25);margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:10px}
.prod-n{font-size:14px;color:#ffd700;font-weight:bold}
.prod-d{font-size:11px;color:#ffe9a8;margin-top:3px}
.prod-p{font-size:15px;font-weight:900;color:#00ff9d;direction:ltr;white-space:nowrap}
.empty{text-align:center;color:#6b8f80;padding:30px 0}
.nw{position:fixed;bottom:14px;left:14px;right:14px;height:76px;padding:2px;border-radius:40px;background:linear-gradient(90deg,#00ff9d,#00d4ff 35%,#bf00ff 70%,#00ff9d);z-index:100}
.bn2{height:100%;border-radius:38px;background:linear-gradient(180deg,#0a1f1a,#04120e);display:flex;align-items:center;justify-content:space-around;padding:0 6px}
.ni{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;color:#9aa8b2;text-decoration:none;font-size:10.5px;padding:8px 4px}
.ni .ic{font-size:22px;filter:grayscale(1) brightness(.85)}
.ni.act{background:linear-gradient(135deg,rgba(0,255,157,.15),rgba(0,200,140,.06));border-radius:20px}
.ni.act .ic{filter:none;color:#00ff9d}.ni.act span:last-child{color:#00ff9d;font-weight:bold}
</style></head><body>

<a class="back-btn" href="/customer/dashboard">→ داشبورد</a>

<div class="frame">
<div class="pt">🔍 جستجو</div>
<form method="GET" class="srch">
<input type="text" name="q" placeholder="مغازه، محصول، شماره..." value="{{ q }}" autofocus>
<button type="submit">🔍</button>
</form>
<div class="hint">🔍 تایپ کن — هر جای کلمه مچ بشه نتایج میاد</div>

{% if q %}

  {# ============ مغازه‌ها ============ #}
  {% if shops %}
  <div class="sec-title">
    <span>🏪 مغازه‌ها</span>
    <span class="sec-count">{{ shops|length }} نتیجه</span>
  </div>
  {% for s in shops %}
  <div class="shop">
  <div>
  <div class="shop-h">🏪 {{ s[2] or s[1] }}</div>
  <div class="shop-m">👤 @{{ s[1] }}</div>
  </div>
  <div class="act-btns">
  {% if s[0] in fav_ids %}
  <form method="POST" action="/customer/fav/{{ s[0] }}" style="margin:0">
  <input type="hidden" name="action" value="remove">
  <button class="btn-fav on" type="submit">⭐</button>
  </form>
  {% else %}
  <form method="POST" action="/customer/fav/{{ s[0] }}" style="margin:0">
  <input type="hidden" name="action" value="add">
  <button class="btn-fav" type="submit">☆</button>
  </form>
  {% endif %}
  <a href="/customer/shop/{{ s[0] }}" class="btn-view">مشاهده</a>
  </div>
  </div>
  {% endfor %}
  {% endif %}

  {# ============ محصولات ============ #}
  {% if products %}
  <div class="sec-title">
    <span>📦 محصولات</span>
    <span class="sec-count">{{ products|length }} نتیجه</span>
  </div>
  {% for p in products %}
  <div class="prod">
  <div>
  <div class="prod-n">{{ p[1] }}</div>
  {% if p[4] %}<div class="prod-d">{{ p[4] }}</div>{% endif %}
  </div>
  <div class="prod-p">{{ "{:,}".format(p[2]) }} ت</div>
  </div>
  {% endfor %}
  {% endif %}

  {# ============ هیچ نتیجه‌ای ============ #}
  {% if not shops and not products %}
  <div class="empty">
  📭 هیچ نتیجه‌ای پیدا نشد<br>
  <small style="font-size:11px;color:#6b8f80;margin-top:8px;display:block">یه کلمهٔ دیگه امتحان کن</small>
  </div>
  {% endif %}

{% else %}

  {# ============ همه مغازه‌ها ============ #}
  {% if shops %}
  <div class="sec-title">
    <span>🏪 همه مغازه‌ها</span>
    <span class="sec-count">{{ shops|length }}</span>
  </div>
  {% for s in shops %}
  <div class="shop">
  <div>
  <div class="shop-h">🏪 {{ s[2] or s[1] }}</div>
  <div class="shop-m">👤 @{{ s[1] }}</div>
  </div>
  <div class="act-btns">
  {% if s[0] in fav_ids %}
  <form method="POST" action="/customer/fav/{{ s[0] }}" style="margin:0">
  <input type="hidden" name="action" value="remove">
  <button class="btn-fav on" type="submit">⭐</button>
  </form>
  {% else %}
  <form method="POST" action="/customer/fav/{{ s[0] }}" style="margin:0">
  <input type="hidden" name="action" value="add">
  <button class="btn-fav" type="submit">☆</button>
  </form>
  {% endif %}
  <a href="/customer/shop/{{ s[0] }}" class="btn-view">مشاهده</a>
  </div>
  </div>
  {% endfor %}
  {% else %}
  <div class="empty">📭 هنوز مغازه‌ای ثبت نشده</div>
  {% endif %}

{% endif %}

</div>

<div class="nw"><div class="bn2">
<a class="ni" href="/customer/dashboard"><span class="ic">🏠</span><span>خانه</span></a>
<a class="ni act" href="/customer/search"><span class="ic">🔍</span><span>جستجو</span></a>
<a class="ni" href="/customer/orders"><span class="ic">📋</span><span>سفارش‌ها</span></a>
<a class="ni" href="/customer/profile"><span class="ic">👤</span><span>پروفایل</span></a>
</div></div>
{% include "_global_bg.html" %}
</body></html>
